# Yogini Arts Backend Environment Variables
# Copy this file to .env in the backend folder

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# Local: mongodb://localhost:27017/yoginiarts
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/yoginiarts
MONGO_URI=mongodb://localhost:27017/yoginiarts

# CORS Configuration (optional - comma-separated list)
# CORS_ORIGINS=http://localhost:3000,https://yoginiarts.com
